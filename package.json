{
	"name": "@cerios/csv-nested-json",
	"version": "1.1.0",
	"author": "Ronald Veth - Cerios",
	"description": "Parse CSV files into nested JSON objects with support for dot notation, arrays, and complex data structures",
	"license": "MIT",
	"keywords": [
		"csv",
		"json",
		"parser",
		"nested",
		"csv-parser",
		"csv-to-json",
		"typescript",
		"javascript",
		"dot-notation",
		"arrays",
		"cerios"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"type": "commonjs",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"bugs": {
		"url": "https://github.com/CeriosTesting/csv-nested-json/issues"
	},
	"homepage": "https://github.com/CeriosTesting/csv-nested-json#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CeriosTesting/csv-nested-json.git"
	},
	"scripts": {
		"biome:migrate": "biome migrate --write",
		"build": "tsup",
		"changeset": "npx changeset",
		"check": "biome check --write",
		"check-exports": "attw --pack .",
		"compile": "tsc --noEmit",
		"dev": "tsc --watch",
		"lint": "biome lint",
		"prepare": "husky",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch",
		"update-all-packages": "npx npm-check-updates -u && npm i"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@biomejs/biome": "2.3.6",
		"@changesets/cli": "^2.29.7",
		"@types/jest": "^29.5.5",
		"@types/node": "^24.10.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.2.6",
		"npm-check-updates": "^19.1.2",
		"ts-jest": "^29.4.5",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
