{
	"name": "@cerios/csv-nested-json",
	"version": "1.3.1",
	"description": "Parse CSV files into nested JSON objects with support for dot notation, arrays, and complex data structures",
	"keywords": [
		"arrays",
		"cerios",
		"csv",
		"csv-parser",
		"csv-to-json",
		"dot-notation",
		"javascript",
		"json",
		"nested",
		"parser",
		"typescript"
	],
	"homepage": "https://github.com/CeriosTesting/csv-nested-json#readme",
	"bugs": {
		"url": "https://github.com/CeriosTesting/csv-nested-json/issues"
	},
	"license": "MIT",
	"author": "Ronald Veth - Cerios",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CeriosTesting/csv-nested-json.git"
	},
	"files": [
		"dist"
	],
	"type": "commonjs",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"changeset": "npx changeset",
		"check-exports": "attw --pack .",
		"compile": "tsc --noEmit",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware --type-check",
		"prepare": "husky",
		"test": "vitest --run",
		"test:coverage": "vitest --coverage",
		"test:watch": "vitest --watch",
		"update-all-packages": "npx npm-check-updates -u && npm i"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"npm-check-updates": "^20.0.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
